<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Audacity-RS"
      Manufacturer="audacity-rs developers"
      Version="$(var.Version)"
      UpgradeCode="{8C63AC10-3B77-4E89-B8A2-746C7849E851}"
      Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Audacity-RS is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="Audacity-RS" Level="1">
      <ComponentRef Id="MainApplication" />
      <ComponentGroupRef Id="StagedFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Audacity-RS">
        <Component Id="MainApplication" Guid="*">
          <File Id="AudacityRSExe" Source="$(var.StageDir)\audacity-rs.exe" KeyPath="yes">
            <ProgId Id="Audacity-RS.Project" Description="Audacity-RS Project">
              <Extension Id="aup3" ContentType="application/x-audacity-project">
                <Verb Id="open" Command="Open" TargetFile="AudacityRSExe" Argument="&quot;%1&quot;" />
              </Extension>
            </ProgId>
          </File>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AudacityRSProgramsFolder" Name="Audacity-RS">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="AudacityRSStartMenuShortcut"
                    Name="Audacity-RS"
                    Description="Launch Audacity-RS"
                    Target="[INSTALLFOLDER]audacity-rs.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKLM"
                         Key="Software\audacity-rs"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
          <RemoveFolder Id="RemoveAudacityRSProgramsFolder" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>

  <!-- Everything else build-cross.sh stages: helper exes (au-nyquist-engine, au-nyquist-worker,
       au-plugin-editor, au-plugin-scan), runtime DLLs, nyquist\, plug-ins\, locale\. -->
  <Fragment>
    <ComponentGroup Id="StagedFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.StageDir)\**">
        <Exclude Files="$(var.StageDir)\audacity-rs.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
